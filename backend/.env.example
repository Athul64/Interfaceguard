# Flask application secret key
SECRET_KEY=interfaceguard-dev-secret-key-change-in-production

# SQLite database path (default is local SQLite database in backend/data)
DATABASE_URL=sqlite:///data/interfaceguard.db

# LLM Provider configuration: "gemini", "openai", or "fallback"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=20

# Optional API Keys (when not provided, InterfaceGuard uses its deterministic expert engine)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=

# Default commit depth cap for large repositories
DEFAULT_MAX_COMMITS=50
